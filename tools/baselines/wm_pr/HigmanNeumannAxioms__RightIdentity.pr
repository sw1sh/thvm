NAME          HigmanNeumannAxiomsRightIdentity
MODE          PROOF
SORTS         ANY
SIGNATURE     fop: ANY ANY -> ANY
              skC1: -> ANY
ORDERING      KBO
              fop=1, skC1=1
              skC1 > fop
VARIABLES     X1, X2, X3: ANY
EQUATIONS     fop(X1,fop(fop(fop(fop(X1,X1),X2),X3),fop(fop(fop(X1,X1),X1),X3))) = X2
CONCLUSION    fop(skC1,fop(skC1,skC1)) = skC1
