NAME          WolframAxiomsDoubleNegation
MODE          PROOF
SORTS         ANY
SIGNATURE     opCenterdot: ANY ANY -> ANY
              skC1: -> ANY
ORDERING      KBO
              opCenterdot=1, skC1=1
              skC1 > opCenterdot
VARIABLES     X1, X2, X3: ANY
EQUATIONS     opCenterdot(opCenterdot(opCenterdot(X1,X2),X3),opCenterdot(X1,opCenterdot(opCenterdot(X1,X3),X1))) = X3
CONCLUSION    opCenterdot(opCenterdot(skC1,skC1),opCenterdot(skC1,skC1)) = skC1
