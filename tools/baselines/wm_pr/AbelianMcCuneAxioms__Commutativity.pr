NAME          AbelianMcCuneAxiomsCommutativity
MODE          PROOF
SORTS         ANY
SIGNATURE     and: ANY ANY -> ANY
              not: ANY -> ANY
              skC1: -> ANY
              skC2: -> ANY
ORDERING      KBO
              and=1, not=1, skC1=1, skC2=1
              skC1 > skC2 > not > and
VARIABLES     X1, X2, X3: ANY
EQUATIONS     and(and(and(X1,X2),X3),not(and(X1,X3))) = X2
CONCLUSION    and(skC1,skC2) = and(skC2,skC1)
