NAME          GroupAxiomsInverseOfInverse
MODE          PROOF
SORTS         ANY
SIGNATURE     and: ANY ANY -> ANY
              k1: -> ANY
              not: ANY -> ANY
              opOvertilde: ANY -> ANY
              skC1: -> ANY
ORDERING      LPO
              k1 > skC1 > not > opOvertilde > and
VARIABLES     X1, X2, X3: ANY
EQUATIONS     and(X1,and(X2,X3)) = and(and(X1,X2),X3)
              and(X1,opOvertilde(k1)) = X1
              and(X1,not(X1)) = opOvertilde(k1)
CONCLUSION    not(not(skC1)) = skC1
