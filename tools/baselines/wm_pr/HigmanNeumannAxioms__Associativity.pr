NAME          HigmanNeumannAxiomsAssociativity
MODE          PROOF
SORTS         ANY
SIGNATURE     fop: ANY ANY -> ANY
              skC1: -> ANY
              skC2: -> ANY
              skC3: -> ANY
ORDERING      KBO
              fop=1, skC1=1, skC2=1, skC3=1
              skC1 > skC2 > skC3 > fop
VARIABLES     X1, X2, X3: ANY
EQUATIONS     fop(X1,fop(fop(fop(fop(X1,X1),X2),X3),fop(fop(fop(X1,X1),X1),X3))) = X2
CONCLUSION    fop(skC1,fop(fop(skC1,skC1),fop(skC2,fop(fop(skC1,skC1),skC3)))) = fop(fop(skC1,fop(fop(skC1,skC1),skC2)),fop(fop(skC1,skC1),skC3))
