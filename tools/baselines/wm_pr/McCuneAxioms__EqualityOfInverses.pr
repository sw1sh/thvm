NAME          McCuneAxiomsEqualityOfInverses
MODE          PROOF
SORTS         ANY
SIGNATURE     and: ANY ANY -> ANY
              not: ANY -> ANY
              skC1: -> ANY
ORDERING      KBO
              and=1, not=1, skC1=1
              skC1 > not > and
VARIABLES     X1, X2, X3, X4: ANY
EQUATIONS     and(X1,not(and(X2,and(and(and(X3,not(X3)),not(and(X4,X2))),X1)))) = X4
CONCLUSION    and(skC1,not(skC1)) = and(not(skC1),skC1)
