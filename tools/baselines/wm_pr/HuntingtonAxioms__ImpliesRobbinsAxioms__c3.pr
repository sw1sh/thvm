NAME          HuntingtonAxiomsImpliesRobbinsAxiomsC3
MODE          PROOF
SORTS         ANY
SIGNATURE     not: ANY -> ANY
              or: ANY ANY -> ANY
              skC1: -> ANY
              skC2: -> ANY
ORDERING      KBO
              not=1, or=1, skC1=1, skC2=1
              skC1 > skC2 > not > or
VARIABLES     X1, X2, X3: ANY
EQUATIONS     or(X1,or(X2,X3)) = or(or(X1,X2),X3)
              or(X1,X2) = or(X2,X1)
              or(not(or(not(X1),X2)),not(or(not(X1),not(X2)))) = X1
CONCLUSION    not(or(not(or(skC1,skC2)),not(or(skC1,not(skC2))))) = skC1
