NAME          MeredithAxiomsAndAssociativity
MODE          PROOF
SORTS         ANY
SIGNATURE     opCenterdot: ANY ANY -> ANY
              skC1: -> ANY
              skC2: -> ANY
              skC3: -> ANY
ORDERING      KBO
              opCenterdot=1, skC1=1, skC2=1, skC3=1
              skC1 > skC2 > skC3 > opCenterdot
VARIABLES     X1, X2, X3: ANY
EQUATIONS     opCenterdot(X1,opCenterdot(X2,opCenterdot(X1,X3))) = opCenterdot(opCenterdot(opCenterdot(X3,X2),X2),X1)
              opCenterdot(opCenterdot(X1,X1),opCenterdot(X2,X1)) = X1
CONCLUSION    opCenterdot(opCenterdot(skC1,opCenterdot(opCenterdot(skC2,skC3),opCenterdot(skC2,skC3))),opCenterdot(skC1,opCenterdot(opCenterdot(skC2,skC3),opCenterdot(skC2,skC3)))) = opCenterdot(opCenterdot(opCenterdot(opCenterdot(skC1,skC2),opCenterdot(skC1,skC2)),skC3),opCenterdot(opCenterdot(opCenterdot(skC1,skC2),opCenterdot(skC1,skC2)),skC3))
