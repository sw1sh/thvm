#!/bin/sh
# ProoVer / StarExec run script.  $1 = a first-order TSTP proof file.
# The same FindProof binary as the CASC prover, in --check mode: it
# validates every derived step and prints one SZS verdict
# (Verified / FailedVerified / NotVerified) for the proof.  The
# per-proof wall-clock limit is taken from the StarExec environment.
HERE=$(cd "$(dirname "$0")/.." && pwd)
LIMIT=${STAREXEC_WALLCLOCK_LIMIT:-30}
THVM_PROOFCHECK_WALL="$LIMIT"; export THVM_PROOFCHECK_WALL
exec "$HERE/bin/FindProof" --check --szs "$1"
