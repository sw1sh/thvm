% Stage 9.4b GRP fixture: commutative-monoid axioms (right-identity
% plus commutativity); the conjecture asks swap-equivalence of two
% distinct constants, f(a, b) = f(b, a).
%
% Commutativity is unorientable.  Ordered rewriting (ATP_ORDERED_REWRITE,
% default-on) stores the equation once and fires whichever direction
% strictly decreases the redex: under the LPO precedence `f > e > a > b`
% the term f(a, b) outranks f(b, a), so f(a, b) normalizes to f(b, a)
% and the single-normal-form goal check closes the conjecture in one
% step.  The pre-ordered-rewriting engine QUEUE_EMPTY'd here -- the
% 2-way unfailing fallback stored u->v and v->u and cycled between the
% two faces without ever reaching a canonical form.
status=PROVED
max_step=1
max_rules=2
